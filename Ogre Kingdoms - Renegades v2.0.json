    "sharedProfiles": [
      {
        "name": "Ogre Kingdoms Charge",
        "id": "c5da-d0ba-2748-6ced",
        "hidden": false,
        "typeId": "c1ac-c1c8-f9d5-9673",
        "typeName": "Special Rule",
        "characteristics": [
          {
            "name": "Description",
            "$text": "The Strength and Armour Piercing characteristics of any impact hits caused by an Infantry model with this special rule are improved by the current rank bonus of its unit, or in the case of characters, the current rank bonus of any unit they have joined. \n\n\nIn addition, if a unit with this special rule makes a Charge move of 6\" or more following a Charge or Pursuit roll that includes one or more natural 6s, all models in the unit gain Impact Hits (1) and treat low linear obstacles as open ground during the turn in which they charge.\n\n\nNote: This means that models separated only by a low linear obstacle are considered to be in base contact with one another for the purposes of combat and the enemy unit receives no benefits for defending a low linear obstacle against this unit.",
            "typeId": "9f84-4221-785a-db50"
          }
        ]
      },
      {
        "name": "Ravenous Hunger",
        "id": "240a-30f9-7ee4-6c83",
        "hidden": false,
        "typeId": "c1ac-c1c8-f9d5-9673",
        "typeName": "Special Rule",
        "characteristics": [
          {
            "name": "Description",
            "$text": "If the majority of the models in a unit have this special rule, it may re-roll its Charge roll.",
            "typeId": "9f84-4221-785a-db50"
          }
        ]
      },
      {
        "name": "Numbing Chill",
        "id": "0109-b00f-c277-32eb",
        "hidden": false,
        "typeId": "c1ac-c1c8-f9d5-9673",
        "typeName": "Special Rule",
        "characteristics": [
          {
            "name": "Description",
            "$text": "Enemy units engaged in combat with one or more models with this rule have the Strikes Last special rule and a -1 modifier to their Weapon Skill characteristic, to a minimum of 1.",
            "typeId": "9f84-4221-785a-db50"
          }
        ]
      },
      {
        "name": "Ogre Club",
        "id": "74ef-797a-5040-c04f",
        "hidden": false,
        "typeId": "c1ac-c1c8-f9d5-9673",
        "typeName": "Special Rule",
        "characteristics": [
          {
            "name": "Description",
            "$text": "A hand weapon carried by a model with this special rule has an Armour Piercing characteristic of -1.\n\n\nNote that this special rule only applies to a single, non-magical hand weapon, and does not apply to a model's mount (should it have one). If the model is using an Ogre Kingdoms Ironfist as a weapon (or any other sort of weapon), this special rule ceases to apply.",
            "typeId": "9f84-4221-785a-db50"
          }
        ]
      },
      {
        "name": "Largely Insignificant",
        "id": "46f6-c093-06ed-473c",
        "hidden": false,
        "typeId": "c1ac-c1c8-f9d5-9673",
        "typeName": "Special Rule",
        "characteristics": [
          {
            "name": "Description",
            "$text": "Units with this special rule never cause friendly units to make Panic tests. However, a unit with this special rule cannot be joined by a character without this special rule.",
            "typeId": "9f84-4221-785a-db50"
          }
        ]
      },
      {
        "name": "Look-Out Gnoblar",
        "id": "5007-b513-f2fb-1fc9",
        "hidden": false,
        "typeId": "c1ac-c1c8-f9d5-9673",
        "typeName": "Special Rule",
        "characteristics": [
          {
            "name": "Description",
            "$text": "A champion or character that has joined a unit with this special rule may make a “Look Out, Sir!” roll if there are two or more rank and file models in the unit (rather than the usual five). In addition, you may re-roll a “Look Out, Sir!” roll if there are five or more rank and file models in the unit.",
            "typeId": "9f84-4221-785a-db50"
          }
        ]
      }
    ],
