    "sharedProfiles": [
      {
        "name": "Lord of the Night",
        "id": "9148-ff9c-8e39-f89d",
        "hidden": false,
        "page": 23,
        "publicationId": "1c5e-3047-5732-f4",
        "typeId": "c1ac-c1c8-f9d5-9673",
        "typeName": "Special Rule",
        "characteristics": [
          {
            "name": "Description",
            "$text": "During the Command sub-phase of their turn, this Vampire may attempt to resurrect fallen creatures of the night by making a Leadership test (using their own Leadership). If this test is passed, a single friendly unit of Fell Bats, Bat Swarms or Dire Wolves that is within 12\" of this model recovers D6 lost Wounds.",
            "typeId": "9f84-4221-785a-db50"
          }
        ]
      },
      {
        "name": "Supernatural Horror",
        "id": "b1c0-2e6e-f18b-e8fc",
        "hidden": false,
        "page": 23,
        "publicationId": "1c5e-3047-5732-f4",
        "typeId": "c1ac-c1c8-f9d5-9673",
        "typeName": "Special Rule",
        "characteristics": [{"name": "Description", "$text": "This Vampire gains the Terror special rule.", "typeId": "9f84-4221-785a-db50"}]
      },
      {
        "name": "Master Of The Black Arts",
        "id": "6e72-c1bd-8ae6-e394",
        "hidden": false,
        "page": 23,
        "publicationId": "1c5e-3047-5732-f4",
        "typeId": "c1ac-c1c8-f9d5-9673",
        "typeName": "Special Rule",
        "characteristics": [
          {
            "name": "Description",
            "$text": "This Vampiric Power may only be taken by a Vampire Lord that is a Level 3 Wizard. This Vampire increases their Level of Wizardry by 1.",
            "typeId": "9f84-4221-785a-db50"
          }
        ]
      },
      {
        "name": "Dark Acolyte",
        "id": "6da7-e741-f22b-66ca",
        "hidden": false,
        "page": 23,
        "publicationId": "1c5e-3047-5732-f4",
        "typeId": "c1ac-c1c8-f9d5-9673",
        "typeName": "Special Rule",
        "characteristics": [{"name": "Description", "$text": "This Vampire gains the Invocation of Nehek special rule (as described on page 5).", "typeId": "9f84-4221-785a-db50"}]
      },
      {
        "name": "Flying Horror",
        "id": "1ce4-84b4-565a-7c67",
        "hidden": false,
        "page": 23,
        "publicationId": "1c5e-3047-5732-f4",
        "typeId": "c1ac-c1c8-f9d5-9673",
        "typeName": "Special Rule",
        "characteristics": [
          {
            "name": "Description",
            "$text": "Models whose troop type is ‘infantry’ only. This Vampire gains the Fly (10) rule, but cannot join a unit.",
            "typeId": "9f84-4221-785a-db50"
          }
        ]
      },
      {
        "name": "Beguile",
        "id": "7826-c0c1-0979-87d6",
        "hidden": false,
        "page": 23,
        "publicationId": "1c5e-3047-5732-f4",
        "typeId": "c1ac-c1c8-f9d5-9673",
        "typeName": "Special Rule",
        "characteristics": [
          {
            "name": "Description",
            "$text": "Enemy units must make a Leadership test before making any rolls To Hit against this model during the Combat phase. If this test is failed, only rolls of a natural 6 will hit.",
            "typeId": "9f84-4221-785a-db50"
          }
        ]
      },
      {
        "name": "Curse of the Revenant",
        "id": "3e0b-e6bc-52ef-1909",
        "hidden": false,
        "page": 23,
        "publicationId": "1c5e-3047-5732-f4",
        "typeId": "c1ac-c1c8-f9d5-9673",
        "typeName": "Special Rule",
        "characteristics": [{"name": "Description", "$text": "This Vampire has a +1 modifier to its Wounds characteristic.", "typeId": "9f84-4221-785a-db50"}]
      },
      {
        "name": "Red Fury",
        "id": "8a5d-54cd-7fa1-49a2",
        "hidden": false,
        "typeId": "c1ac-c1c8-f9d5-9673",
        "typeName": "Special Rule",
        "characteristics": [
          {
            "name": "Description",
            "$text": "Level 1 Wizard Vampires only. During the Combat phase, for each unsaved wound caused by this model's Attacks, it immediately makes one additional Attack. These additional Attacks cannot generate further Attacks.",
            "typeId": "9f84-4221-785a-db50"
          }
        ]
      },
      {
        "name": "Honour or Death",
        "id": "de2a-66cb-f45f-cb4e",
        "hidden": false,
        "typeId": "c1ac-c1c8-f9d5-9673",
        "typeName": "Special Rule",
        "characteristics": [
          {
            "name": "Description",
            "$text": "Any enemy model that wishes to issue a challenge whilst engaged in the same combat as a model with this Vampiric Power must first make a Leadership test (using their own Leadership.) Apply a +1 modifier to the dice roll for each point of difference between its Weapon Skill characteristic and that of the model with this Vampiric Power (to a maximum of +2).\n\n\nIf the test is passed, the challenge is issued as normal. If the test is failed, the challenge is not issued and the enemy model must Retire, following the rules for refusing a challenge. In addition, challenges issued by a model with this Vampiric Power cannot be refused.",
            "typeId": "9f84-4221-785a-db50"
          }
        ]
      },
      {
        "name": "Quickblood",
        "id": "cf51-d5c8-8d06-34ce",
        "hidden": false,
        "typeId": "c1ac-c1c8-f9d5-9673",
        "typeName": "Special Rule",
        "characteristics": [{"name": "Description", "$text": "This Vampire gains the Strike First special rule.", "typeId": "9f84-4221-785a-db50"}]
      },
      {
        "name": "Infinite Hatred",
        "id": "e405-09c6-7767-e6fd",
        "hidden": false,
        "typeId": "c1ac-c1c8-f9d5-9673",
        "typeName": "Special Rule",
        "characteristics": [{"name": "Description", "$text": "This Vampire gains the Hatred (all enemies) special rule.", "typeId": "9f84-4221-785a-db50"}]
      }
    ],
